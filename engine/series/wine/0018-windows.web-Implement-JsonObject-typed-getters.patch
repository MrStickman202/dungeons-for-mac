+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IJsonValue_Release( child_value );
+    hr = IJsonObject_GetNamedValue( json_object, str, &child_value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
