+    hr = IJsonObject_GetNamedNumber( json_object, str, &child_number );
+    ok( hr == E_ILLEGAL_METHOD_CALL, "got hr %#lx.\n", hr );
+    hr = IJsonObject_GetNamedBoolean( json_object, str, &child_boolean );
+    ok( hr == E_ILLEGAL_METHOD_CALL, "got hr %#lx.\n", hr );
+
