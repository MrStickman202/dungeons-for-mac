+    hr = WindowsCreateString( L"[]", wcslen( L"[]" ), &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IJsonValueStatics_Parse( json_value_statics, str, &child_value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
