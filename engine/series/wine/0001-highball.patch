+    case SPEAKER_BACK_RIGHT: return side ? kAudioChannelLabel_RearSurroundRight : kAudioChannelLabel_RightSurround;
+    case SPEAKER_FRONT_LEFT_OF_CENTER: return kAudioChannelLabel_LeftCenter;
+    case SPEAKER_FRONT_RIGHT_OF_CENTER: return kAudioChannelLabel_RightCenter;
+    case SPEAKER_BACK_CENTER: return kAudioChannelLabel_CenterSurround;
+    case SPEAKER_SIDE_LEFT: return kAudioChannelLabel_LeftSurround;
+    case SPEAKER_SIDE_RIGHT: return kAudioChannelLabel_RightSurround;
+    case SPEAKER_TOP_CENTER: return kAudioChannelLabel_TopCenterSurround;
+    case SPEAKER_TOP_FRONT_LEFT: return kAudioChannelLabel_LeftTopFront;
+    case SPEAKER_TOP_FRONT_CENTER: return kAudioChannelLabel_CenterTopFront;
+    case SPEAKER_TOP_FRONT_RIGHT: return kAudioChannelLabel_RightTopFront;
+    case SPEAKER_TOP_BACK_LEFT: return kAudioChannelLabel_LeftTopRear;
+    case SPEAKER_TOP_BACK_CENTER: return kAudioChannelLabel_CenterTopRear;
+    case SPEAKER_TOP_BACK_RIGHT: return kAudioChannelLabel_RightTopRear;
+    }
+    return kAudioChannelLabel_Unused;
+}
+
+static UInt32 device_output_channels(AudioDeviceID dev)
+{
+    AudioObjectPropertyAddress addr = { kAudioDevicePropertyStreamConfiguration, kAudioObjectPropertyScopeOutput,
+                                        kAudioObjectPropertyElementMain };
+    AudioBufferList *buffers;
+    UInt32 size = 0, i, channels = 0;
+
+    if(AudioObjectGetPropertyDataSize(dev, &addr, 0, NULL, &size) != noErr || !(buffers = malloc(size)))
+        return 0;
+    if(AudioObjectGetPropertyData(dev, &addr, 0, NULL, &size, buffers) == noErr)
+        for(i = 0; i < buffers->mNumberBuffers; i++)
+            channels += buffers->mBuffers[i].mNumberChannels;
+    free(buffers);
+    return channels;
+}
+
+/* Speakers in the Mac itself, headphones (built-in jack, Bluetooth, USB headsets), or anything
+ * else as external speakers. HB_SPATIAL=speakers|headphones|external overrides the guess. */
+static UInt32 spatial_output_type(AudioDeviceID dev)
+{
+    AudioObjectPropertyAddress addr = { kAudioDevicePropertyTransportType, kAudioObjectPropertyScopeGlobal,
+                                        kAudioObjectPropertyElementMain };
+    const char *env = getenv("HB_SPATIAL");
+    UInt32 transport = 0, source = 0, size = sizeof(transport);
+
+    if(env && !strcmp(env, "speakers")) return kSpatialMixerOutputType_BuiltInSpeakers;
+    if(env && !strcmp(env, "headphones")) return kSpatialMixerOutputType_Headphones;
+    if(env && !strcmp(env, "external")) return kSpatialMixerOutputType_ExternalSpeakers;
+
+    AudioObjectGetPropertyData(dev, &addr, 0, NULL, &size, &transport);
+    switch(transport){
+    case kAudioDeviceTransportTypeBuiltIn:
+        addr.mSelector = kAudioDevicePropertyDataSource;
+        addr.mScope = kAudioObjectPropertyScopeOutput;
+        size = sizeof(source);
+        if(AudioObjectGetPropertyData(dev, &addr, 0, NULL, &size, &source) == noErr && source == 'hdpn')
+            return kSpatialMixerOutputType_Headphones;
+        return kSpatialMixerOutputType_BuiltInSpeakers;
+    case kAudioDeviceTransportTypeBluetooth:
+    case kAudioDeviceTransportTypeBluetoothLE:
+    case kAudioDeviceTransportTypeUSB:
+        return kSpatialMixerOutputType_Headphones;
+    default:
+        return kSpatialMixerOutputType_ExternalSpeakers;
+    }
+}
+
+static OSStatus spatial_source_cb(void *user, AudioUnitRenderActionFlags *flags,
+        const AudioTimeStamp *ts, UInt32 bus, UInt32 nframes, AudioBufferList *data)
+{
+    struct coreaudio_stream *stream = user;
+    UInt32 nch = stream->fmt->nChannels, i, c;
+    AudioBufferList interleaved;
+    float *src = stream->spatial_buf;
+
+    if(nframes > stream->spatial_frames) nframes = stream->spatial_frames;
+    interleaved.mNumberBuffers = 1;
+    interleaved.mBuffers[0].mNumberChannels = nch;
+    interleaved.mBuffers[0].mDataByteSize = nframes * stream->fmt->nBlockAlign;
+    interleaved.mBuffers[0].mData = src;
+    ca_render_cb(stream, flags, ts, 0, nframes, &interleaved);
+
+    for(c = 0; c < nch && c < data->mNumberBuffers; c++){
+        float *dst = data->mBuffers[c].mData;
+        for(i = 0; i < nframes; i++) dst[i] = src[i * nch + c];
+    }
+    if(stream->spatial_lfe >= 0 && data->mNumberBuffers >= 2){
+        float *l = data->mBuffers[0].mData, *r = data->mBuffers[1].mData, *lfe = data->mBuffers[stream->spatial_lfe].mData;
+        for(i = 0; i < nframes; i++){ l[i] += 0.5f * lfe[i]; r[i] += 0.5f * lfe[i]; lfe[i] = 0.0f; }
+    }
+    return noErr;
+}
+
+static OSStatus spatial_pull_cb(void *user, AudioUnitRenderActionFlags *flags,
+        const AudioTimeStamp *ts, UInt32 bus, UInt32 nframes, AudioBufferList *data)
+{
+    struct coreaudio_stream *stream = user;
+    return AudioUnitRender(stream->spatial, flags, ts, 0, nframes, data);
+}
