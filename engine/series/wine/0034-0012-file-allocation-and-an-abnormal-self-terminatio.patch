From bbb263a064838536e570fe7987e16ab7dc425710 Mon Sep 17 00:00:00 2001
From: Ferestre contributors <ferestre@users.noreply.github.com>
Date: Sat, 24 Oct 2026 19:16:04 +0300
Subject: [PATCH 34/79] 
 0012-file-allocation-and-an-abnormal-self-termination-is-w

Ported by hand to the CrossOver 26.3 tree from Ferestre's 0012: this tree had no FileAllocationInformation case at all (it answered STATUS_NOT_IMPLEMENTED), so the case is added rather than replacing a stub.
---
 dlls/ntdll/unix/file.c    | 34 ++++++++++++++++++++++++++++++++++
 dlls/ntdll/unix/process.c |  9 ++++++++-
 2 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index b5fe34a..7b3e593 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5245,6 +5245,40 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         else status = STATUS_INVALID_PARAMETER_3;
         break;
 
+    case FileAllocationInformation:
+        if (len >= sizeof(FILE_ALLOCATION_INFORMATION))
+        {
+            const FILE_ALLOCATION_INFORMATION *info = ptr;
+            struct stat st;
+
+            if ((status = server_get_unix_fd( handle, FILE_WRITE_DATA, &fd, &needs_close, NULL, NULL )))
+                return io->Status = status;
+
+            if (fstat( fd, &st ) == -1) status = errno_to_status( errno );
+            else if (S_ISDIR( st.st_mode )) status = STATUS_INVALID_DEVICE_REQUEST;
+            else if (info->AllocationSize.QuadPart < st.st_size)
+            {
+                /* Setting the allocation below end of file truncates on
+                 * Windows, and that part is observable. Go through the server
+                 * so the change is shared the same way FileEndOfFileInformation's is. */
+                if (needs_close) close( fd );
+                needs_close = FALSE;
+                SERVER_START_REQ( set_fd_eof_info )
+                {
+                    req->handle = wine_server_obj_handle( handle );
+                    req->eof    = info->AllocationSize.QuadPart;
+                    status = wine_server_call( req );
+                }
+                SERVER_END_REQ;
+            }
+            /* Growing the allocation is a hint, answered with success and
+             * nothing else: reserved blocks past end of file would never be
+             * given back on a Unix filesystem. */
+            if (needs_close) close( fd );
+        }
+        else status = STATUS_INVALID_PARAMETER_3;
+        break;
+
     case FilePipeInformation:
         if (len >= sizeof(FILE_PIPE_INFORMATION))
         {
diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index cfe7014..a498cf3 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -1512,7 +1512,14 @@ NTSTATUS WINAPI NtTerminateProcess( HANDLE handle, LONG exit_code )
     {
         if (!handle) process_exiting = TRUE;
         else if (process_exiting) exit_process( exit_code );
-        else abort_process( exit_code );
+        else
+        {
+            /* Not an orderly exit: no DLL detach, no destructors, usually no
+             * message, and a Unix parent only sees the exit code's low byte.
+             * Say it at warn level so a log can tell what happened. */
+            WARN( "process terminating itself abnormally, exit code %#x\n", (unsigned int)exit_code );
+            abort_process( exit_code );
+        }
     }
     return ret;
 }
