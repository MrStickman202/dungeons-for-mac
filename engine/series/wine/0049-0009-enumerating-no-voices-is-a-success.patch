From 9378c1f12b3c71818dee2ca63ae4be5ec8bcd5da Mon Sep 17 00:00:00 2001
From: Ferestre contributors <ferestre@users.noreply.github.com>
Date: Sat, 24 Oct 2026 19:18:13 +0300
Subject: [PATCH 49/79] 0009-enumerating-no-voices-is-a-success

Applied to dlls/xgameruntime from Ferestre's patches/xgameruntime/0009-enumerating-no-voices-is-a-success.patch.
---
 dlls/xgameruntime/xaccessibility.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/dlls/xgameruntime/xaccessibility.c b/dlls/xgameruntime/xaccessibility.c
index 4e0a07d..54cf458 100644
--- a/dlls/xgameruntime/xaccessibility.c
+++ b/dlls/xgameruntime/xaccessibility.c
@@ -103,8 +103,18 @@ static HRESULT WINAPI x_accessibility_XSpeechToTextSendString( IXAccessibilityIm
 
 static HRESULT WINAPI x_accessibility_XSpeechSynthesizerEnumerateInstalledVoices( IXAccessibilityImpl2 *iface, void *context, XSpeechSynthesizerInstalledVoicesCallback *callback )
 {
-    FIXME( "iface %p, context %p, callback %p stub!\n", iface, context, callback );
-    return E_NOTIMPL;
+    TRACE( "iface %p, context %p, callback %p.\n", iface, context, callback );
+
+    if (!callback) return E_INVALIDARG;
+
+    /* There is no speech synthesiser here, so there are no installed voices to
+     * report -- and reporting none is a success, not a failure. Windows returns
+     * S_OK and calls the callback once per voice; a machine with none simply
+     * gets no calls. E_NOTIMPL says something else entirely: that asking was
+     * invalid. A title that enumerates voices while starting up and is told the
+     * question does not exist has nothing sensible to do with that, and this is
+     * a question Forza Horizon 5 asks. */
+    return S_OK;
 }
 
 static HRESULT WINAPI x_accessibility_XSpeechSynthesizerCreate( IXAccessibilityImpl2 *iface, XSpeechSynthesizerHandle *speechSynthesizer )
